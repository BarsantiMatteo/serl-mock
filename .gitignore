# -----------------------------------------------------------
# PYTHON ARTIFACTS
# -----------------------------------------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
*.pkl
*.py[oc]

# Build artifacts
build/
dist/
wheels/
*.egg-info/
*.egg

# Byte-compiled / optimized / DLL files
*.so
*.dll
*.dylib

# -----------------------------------------------------------
# ENVIRONMENTS
# -----------------------------------------------------------
# uv creates .venv automatically
.venv/
.env/
env/
venv/

# -----------------------------------------------------------
# DATA 
# -----------------------------------------------------------
# Generated outputs — recreated by scripts/generate_mock_data.py.
# Nested under data/mock/<output_label>/ (defaults to edition<N>/); this blanket
# rule covers that whole tree regardless of output_label.
data/mock/


# -----------------------------------------------------------
# DOCUMENTATION FILES 
# -----------------------------------------------------------
# Only ignore large PDFs; CSV data dictionaries are tracked inputs
docs/documentation/*.pdf
working_notes.md

# -----------------------------------------------------------
# DUCKDB FILES 
# -----------------------------------------------------------
*.duckdb

# -----------------------------------------------------------
# ERA5 FILES 
# -----------------------------------------------------------
*.nc

# -----------------------------------------------------------
# JUPYTER NOTEBOOKS
# -----------------------------------------------------------
.ipynb_checkpoints/
*.ipynb_convert/
**/.ipynb_checkpoints/

# -----------------------------------------------------------
# EDITOR / SYSTEM FILES
# -----------------------------------------------------------

# VS Code
.vscode/
*.code-workspace

# PyCharm
.idea/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
desktop.ini

# -----------------------------------------------------------
# LOGS / TEMP / CACHE
# -----------------------------------------------------------
*.log
*.tmp
*.temp
*.cache
.cache/
__snapshots__/
coverage/
htmlcov/
.pytest_cache/

# -----------------------------------------------------------
# PROJECT-SPECIFIC IGNORE RULES
# -----------------------------------------------------------

# Ignore VS Code settings folder (contains user-specific settings and should not be committed)
.vscode/